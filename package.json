{
  "name": "yt-ticker-gadget",
  "version": "1.0.0",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "install-deps": "npm install",
    "dist": "electron-builder --win --publish=never",
    "dist:dir": "electron-builder --win --dir --publish=never"
  },
  "build": {
    "appId": "com.ytticker.gadget",
    "productName": "YouTube Ticker",
    "directories": {
      "output": "dist"
    },
    "forceCodeSigning": false,
    "win": {
      "target": "nsis",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "files": [
      "**/*",
      "!**/*.map",
      "!dist/**",
      "!build/**",
      "!*.zip",
      "!README.md"
    ]
  },
  "devDependencies": {
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "ws": "^8.17.0",
    "youtube-transcript": "^1.3.1"
  }
}
